#!/usr/bin/env bash
# Stand-in for the agent CLI during recording: shows the exact resume command
# `ah resume` launched and where, then the tail of that session, without
# needing an authenticated agent.
agent="$(basename "$0")"
id="${!#}"
printf '\n\e[2m$ %s %s\e[0m\n' "$agent" "$*"
printf '\e[38;2;255;184;108m●\e[0m \e[1m%s\e[0m resumed in \e[38;2;189;147;249m%s\e[0m\n\n' "$agent" "${PWD/#$HOME/\~}"
ah show "$id" 2>/dev/null | tail -n 4
printf '\n\e[38;2;255;121;198m›\e[0m '
sleep 60
